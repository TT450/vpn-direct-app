{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpndirect.local/interop/evidence/schema.json",
  "title": "VPN Direct device evidence",
  "description": "One qualification run. Do not invent RSS or pass/fail; leave null until a real device battle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "core_sha",
    "device",
    "protocol",
    "panel",
    "rss_startup_mb",
    "rss_connected_idle_mb",
    "rss_under_traffic_mb",
    "rss_peak_mb",
    "pass",
    "fail"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "core_sha": {
      "type": "string",
      "description": "Git SHA or Core stamp of the build under test"
    },
    "device": {
      "type": "string",
      "description": "Hardware model + OS"
    },
    "protocol": {
      "type": "string",
      "description": "Protocol under test (vless, hysteria2, ...)"
    },
    "panel": {
      "type": ["string", "null"],
      "description": "Panel id if subscription-sourced; else null"
    },
    "rss_startup_mb": {
      "type": ["number", "null"],
      "description": "RSS shortly after launch (MB)"
    },
    "rss_connected_idle_mb": {
      "type": ["number", "null"],
      "description": "RSS with tunnel up, idle (MB)"
    },
    "rss_under_traffic_mb": {
      "type": ["number", "null"],
      "description": "RSS during sustained traffic (MB)"
    },
    "rss_peak_mb": {
      "type": ["number", "null"],
      "description": "Peak RSS in the session (MB)"
    },
    "pass": {
      "type": ["boolean", "null"],
      "description": "Overall row pass; null until judged"
    },
    "fail": {
      "type": ["boolean", "null"],
      "description": "Explicit fail flag; null until judged"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "date": {
      "type": ["string", "null"],
      "description": "ISO-8601 UTC date of the run"
    }
  }
}
