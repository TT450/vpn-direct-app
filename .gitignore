# =============================================================================
# Backend / Direct API / ops — NEVER GitHub (local + server only)
# Do not force-add these. Do not put real hosts, IPs, routes, or secrets
# into tracked files either — ignore alone is not enough if they live in UI/docs.
# =============================================================================
/VPNDirectPatch/
/_private_vpndirect/
/private_backend/
/backend/
/ops/backend/
**/.env.backend
**/backend.secrets*
**/mobile_api.py
**/mobile_api.server.py

# Client ↔ backend (local only)
**/DirectBackendAPI.swift
**/DirectBackendHooks.swift
**/DirectBackendConfig.swift
**/DirectBackend.secrets*
**/DirectBackend*.local.swift
**/DirectBackendPrivate*.swift

# Harmony local Direct backend (never GitHub)
# DirectBackendLocal.ets is TRACKED (empty stub). Real hosts live in *.local.ets only.
harmony/**/DirectBackendAPI.local.ets
harmony/**/DirectBackendHooks.local.ets
harmony/**/DirectBackend*.local.ets
harmony/**/backend_private/**
**/direct_backend.local.json

# Google OAuth local plist (never GitHub)
**/GoogleOAuth.local.plist
**/client_*.apps.googleusercontent.com.plist

# Local ASC / RevenueCat key material — never under app source trees (Xcode sync copies them into the IPA)
**/ApplicationLibrary/Views/DirectUI/secrets/
**/SubscriptionKey_*.p8
/private/
/private/**
