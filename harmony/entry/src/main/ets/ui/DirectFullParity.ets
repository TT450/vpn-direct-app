@Component struct DirectSettingsParity { @Prop flow:DirectFlow=DirectFlow.Security; @Prop onClose:()=>void=()=>{}; build(){Scroll(){Column(){DirectParityPage({kicker:'DIRECT / SETTINGS',title:this.title(),subtitle:'Параметры подключения и приложения.',onClose:this.onClose});DirectParityRow({mark:'01',title:'Статус',subtitle:'Текущее состояние VPN Direct'});DirectParityRow({mark:'02',title:'Системные настройки',subtitle:'Параметры HarmonyOS и разрешения'});DirectParityRow({mark:'03',title:'Диагностика',subtitle:'Сведения для проверки соединения'});DirectParityRow({mark:'04',title:'О приложении',subtitle:'VPN Direct · HarmonyOS'})}.padding({left:20,right:20})}.scrollBar(BarState.Off).width('100%').height('100%').backgroundColor(DirectTheme.paper)} private title(){if(this.flow===DirectFlow.About)return'О приложении';if(this.flow===DirectFlow.Diagnostics)return'Диагностика';if(this.flow===DirectFlow.Security)return'Безопасность';if(this.flow===DirectFlow.Connection)return'Соединение';if(this.flow===DirectFlow.Activity)return'Активность';return'Настройки'}}
@Component struct DirectOperationParity { @Prop flow:DirectFlow=DirectFlow.PaymentProcessing; @Prop onClose:()=>void=()=>{}; build(){Column(){DirectParityPage({kicker:'DIRECT / STATE',title:this.title(),subtitle:'Операция выполняется или ожидает результата.',onClose:this.onClose});Column(){Text(this.status()).fontSize(10).fontWeight(FontWeight.Bold).fontFamily('monospace').fontColor(DirectTheme.muted);Text('Состояние синхронизируется с сервисом.').fontSize(13).fontColor(DirectTheme.ink).margin({top:10})}.padding(18).width('100%').backgroundColor(Color.White.opacity(0.35)).border({width:1,color:DirectTheme.line})}.padding({left:20,right:20}).backgroundColor(DirectTheme.paper).width('100%').height('100%')} private title(){if(this.flow===DirectFlow.PaymentSuccess)return'Готово';if(this.flow===DirectFlow.PaymentError)return'Ошибка';if(this.flow===DirectFlow.PaymentCancelled)return'Отменено';if(this.flow===DirectFlow.PaymentWaiting)return'Ожидание';return'Обработка'} private status(){if(this.flow===DirectFlow.PaymentSuccess)return'ОПЕРАЦИЯ ЗАВЕРШЕНА';if(this.flow===DirectFlow.PaymentError)return'НЕ УДАЛОСЬ ЗАВЕРШИТЬ';if(this.flow===DirectFlow.PaymentCancelled)return'ОПЕРАЦИЯ ОТМЕНЕНА';return'ОБРАБОТКА'}}
