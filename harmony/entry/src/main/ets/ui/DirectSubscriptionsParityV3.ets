    Scroll() { Column() {
      Row() { Column() { Text('01').fontSize(9).fontWeight(FontWeight.Bold).fontColor(DirectTheme.green).fontFamily('monospace'); Row().width(14).height(2).backgroundColor(DirectTheme.acid).margin({ top: 3, bottom: 4 }); Text('ПОДКЛЮЧЕНИЕ / ПОДПИСКИ').fontSize(9).fontWeight(FontWeight.Bold).fontColor(DirectTheme.muted).fontFamily('monospace'); Text('Подписки').fontSize(34).fontWeight(600).fontColor(DirectTheme.ink).margin({ top: 5 }); Text('VPN Direct — первым, добавленные — ниже').fontSize(11).fontWeight(FontWeight.Medium).fontColor(DirectTheme.muted).margin({ top: 3 }); }.alignItems(HorizontalAlign.Start).layoutWeight(1); Text('×').fontSize(18).fontWeight(FontWeight.Bold).fontColor(DirectTheme.acid).width(38).height(38).textAlign(TextAlign.Center).backgroundColor(DirectTheme.ink).onClick(() => { DirectHaptics.navigation(); this.onClose(); }); }.width('100%').padding({ left: 20, right: 20, top: 28, bottom: 15 }).border({ width: { bottom: 1 }, color: DirectTheme.line });
      if (this.hasDirect) { Column() { Row() { Column() { Text('VPN DIRECT · ОСНОВНАЯ').fontSize(9).fontWeight(FontWeight.Bold).fontColor(DirectTheme.acid).fontFamily('monospace'); Text(this.planName.length > 0 ? this.planName : 'VPN Direct').fontSize(20).fontWeight(600).fontColor(DirectTheme.white).margin({ top: 4 }); Text(this.remainingDays > 0 ? `${this.remainingDays} дн · основной доступ аккаунта` : 'Основной доступ аккаунта').fontSize(10).fontColor('#85FFFFFF').margin({ top: 4 }); }.alignItems(HorizontalAlign.Start).layoutWeight(1); Text('ОСНОВНАЯ').fontSize(8).fontWeight(FontWeight.Bold).fontColor(DirectTheme.acid).fontFamily('monospace').padding({ left: 8, right: 8, top: 7, bottom: 7 }).border({ width: 1, color: '#B3A8F069' }); }.width('100%'); Row() { Text('УПРАВЛЯТЬ VPN DIRECT').fontSize(9).fontWeight(FontWeight.Bold).fontColor(DirectTheme.acid).fontFamily('monospace'); Blank(); Text('→').fontSize(12).fontColor(DirectTheme.acid); }.width('100%').height(44).padding({ left: 13, right: 13 }).backgroundColor(DirectTheme.ink).margin({ top: 12 }); }.width('100%').padding(16).backgroundColor(DirectTheme.ink).border({ width: 1, color: '#B3A8F069' }).margin({ left: 20, right: 20, top: 18 }).onClick(() => this.activateDirect()); }
      else { Column() { Text('VPN DIRECT').fontSize(9).fontWeight(FontWeight.Bold).fontColor(DirectTheme.acid).fontFamily('monospace'); Text('Основной доступ не активирован').fontSize(17).fontWeight(600).fontColor(DirectTheme.white).margin({ top: 6 }); Text('Оформите тариф VPN Direct или добавьте внешнюю подписку.').fontSize(10).fontColor('#85FFFFFF').margin({ top: 5 }); }.width('100%').padding(16).backgroundColor(DirectTheme.ink).margin({ left: 20, right: 20, top: 18 }).onClick(() => this.onFlow(DirectFlow.Plans)); }
