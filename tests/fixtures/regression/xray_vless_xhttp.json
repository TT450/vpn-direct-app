{
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "proxy",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [{ "id": "11111111-1111-1111-1111-111111111111", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": { "serverName": "www.example.com", "fingerprint": "chrome" },
        "xhttpSettings": { "path": "/xhttp", "host": "www.example.com", "mode": "auto" }
      }
    },
    { "protocol": "freedom", "tag": "direct" }
  ]
}
